# Copy this file to backend/.env. Never commit the resulting file.

# Database: use SQLite for a local smoke test, or match PostgreSQL settings in
# the repository-root .env file when using Docker Compose.
DATABASE_URL=sqlite:///./lifehub_open.db
DEV_CREATE_TABLES=true

# Device request validation. false is required for any shared or networked deployment.
SKIP_AUTH=true

# Configure one or more providers only when live AI functionality is needed.
DEEPSEEK_API_KEY=
MIMO_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# Optional semantic-memory embedding endpoint (OpenAI-compatible).
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# Optional TTS. Use only voices and source material you are authorized to use.
MINIMAX_API_KEY=
MINIMAX_TTS_ENABLED=false
MINIMAX_TTS_MODEL=
MINIMAX_TTS_VOICE=

# Optional vision provider.
MIMO_VISION_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_VISION_MODEL=mimo-v2.5

# Local storage and conservative defaults.
UPLOAD_DIR=uploads
MAX_MEDIA_SIZE=52428800
AI_CHAT_HISTORY_MAX_MESSAGES=40
AI_CHAT_HISTORY_MAX_CHARS=16000
CHARACTER_LORE_MAX_CHARS=6000
CHARACTER_PUBLIC_HISTORY_MAX_CHARS=7000
AI_STICKER_REPLIES_ENABLED=false

# Personal-health synchronization is off by default. Its credentials must never
# be committed or shared.
MI_FITNESS_SYNC_ENABLED=false
MI_FITNESS_USER_ID=
MI_FITNESS_PASS_TOKEN=
MI_FITNESS_REGION=cn

# Temporarily restore life/study/exercise APIs, tools, snapshot and fitness jobs.
# Also launch the mobile app with --dart-define=LIFE_TRACKING_ENABLED=true.
LIFE_TRACKING_ENABLED=false
